{
	"info": {
		"_postman_id": "7f8b9123-rest-lab-enterprise-experiments",
		"name": "REST API Enterprise Lab (Exp 2.1.1 - 2.3.2)",
		"description": "Comprehensive Postman test collection covering all 6 experiments:\n- Exp 2.1.1: REST CRUD, Bean Validation, Standardized Responses, CORS\n- Exp 2.1.2: Global Exception Handling & Correlation ID Logging\n- Exp 2.2.1: Pagination & Sorting via Spring Data Pageable\n- Exp 2.2.2: Caching (Caffeine), N+1 Problem Resolution (JOIN FETCH), Native SQL\n- Exp 2.3.1: JWT Authentication & Role-Based Access Control (RBAC)\n- Exp 2.3.2: AES-256 GCM Sensitive Data Encryption & Refresh Token Rotation",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
